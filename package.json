{
  "name": "werstakoff-ai-constructor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev:api": "pnpm --filter @werstakoff/api dev",
    "dev:worker": "pnpm --filter @werstakoff/worker dev",
    "dev:web": "pnpm --filter @werstakoff/web dev",
    "db:generate": "pnpm --filter @werstakoff/db generate",
    "db:migrate": "pnpm --filter @werstakoff/db migrate",
    "db:seed": "pnpm --filter @werstakoff/db seed",
    "catalog:import": "pnpm --filter @werstakoff/catalog import",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
