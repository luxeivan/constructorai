# Пример production-.env для constructorai.luxeivan.ru
# Скопировать в /opt/constructorai/.env, заменить CHANGE_ME и вписать POLZA_TOKEN.
# Права: chmod 600 .env. Файл не коммитится.
# Пароли — только латиница/цифры/дефис (удобно: openssl rand -hex 24).

# --- Postgres ---
POSTGRES_USER=werstakoff
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD
POSTGRES_DB=werstakoff
DATABASE_URL=postgresql://werstakoff:CHANGE_ME_PG_PASSWORD@postgres:5432/werstakoff

# --- Redis / storage ---
REDIS_URL=redis://redis:6379
STORAGE_DRIVER=fs
STORAGE_DIR=/app/storage
MINIO_BUCKET=werstakoff

# --- AI ---
POLZA_TOKEN=CHANGE_ME_POLZA_TOKEN
AI_SESSION_BUDGET_RUB=60

# --- Admin ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# --- App ---
PUBLIC_BASE_URL=https://constructorai.luxeivan.ru
PHOTO_RETENTION_DAYS=365
WEB_PORT=8081
